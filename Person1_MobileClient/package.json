{
  "name": "pnsm-mobile-edge-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:obfuscated": "cross-env OBFUSCATE=1 vite build --outDir dist-obfuscated",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > sbom.json",
    "audit:capacitor": "node scripts/audit-capacitor-parity.mjs"
  },
  "dependencies": {
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "axios": "^1.7.9",
    "capacitor-mock-location-checker": "^0.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "mixme": "^2.0.2",
    "protobufjs": "^8.8.0",
    "minimatch": "^10.2.6",
    "braces": "^3.0.3",
    "decode-uri-component": "^0.5.0",
    "js-yaml": "^5.4.1",
    "diff": "^9.0.0",
    "ssh2": "^1.17.0",
    "micromatch": "^4.0.8",
    "nunjucks": "^3.2.4"
  }
}
