# =============================================================================
# PNSM Web Command Center (Person 2) — environment contract
# Copy to `.env.local` and adjust. `.env.local` is git-ignored.
#
# ###########################################################################
# #  READ THIS FIRST                                                        #
# #  Vite inlines every VITE_-prefixed variable into the JavaScript bundle   #
# #  at BUILD time. They are readable by anyone who opens DevTools.         #
# #                                                                          #
# #  There is no server runtime in this project, so THERE IS NOWHERE SAFE    #
# #  to put a secret. AWS IAM keys, the MongoDB connection string and the    #
# #  JWT signing secret belong to Person 3's Express container and Person    #
# #  4's ECS task definition — never here.                                   #
# ###########################################################################

# -- Mode ---------------------------------------------------------------------
# 1 = serve everything from the in-process mock backend with a simulated live
#     feed. No Express, no Atlas, no AWS. Also the demo-day fallback.
# 0 = talk to Person 3's real API.
VITE_DEMO_MODE=1

# -- Person 3's Express 5 API -------------------------------------------------
# Include the /api prefix. The browser calls this cross-origin, so Person 3
# must allow this origin with `credentials: true` (a wildcard origin is invalid
# when credentials are sent). See docs/04-MESSAGES-TO-TEAM.md.
VITE_API_BASE_URL=http://localhost:5000/api

# Socket.IO origin — the server root, with no /api prefix.
VITE_SOCKET_URL=http://localhost:5000

# -- Local development convenience -------------------------------------------
# Set to 1 to route /api through Vite's dev proxy and sidestep CORS while
# developing. Production is always cross-origin, so Person 3's CORS config still
# has to be correct; this only removes local friction.
# VITE_USE_DEV_PROXY=0
# VITE_API_ORIGIN=http://localhost:5000

# -- Mapping ------------------------------------------------------------------
# The console uses MapLibre GL JS (the open fork of Mapbox GL JS) with OSM raster
# tiles, so no key is needed and the map works offline-ish out of the box.
# Attribution is REQUIRED by the OSM tile usage policy; bulk prefetching is not
# permitted. To switch to Mapbox vector tiles instead, supply a token and follow
# the note in src/components/map/gl.ts.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# VITE_MAPBOX_TOKEN=

# -- Build metadata -----------------------------------------------------------
# Surfaced in Settings so a stale CloudFront cache is identifiable at a glance.
VITE_APP_VERSION=2.0.0
