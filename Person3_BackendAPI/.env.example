# Copy to .env and fill in locally / in your deploy platform's env settings.
# Never commit the filled-in .env — .gitignore already blocks it.

NODE_ENV=development
PORT=5000

# --- Database -------------------------------------------------------------
# Atlas M0 for the course demo. Co-locate the cluster with the API region:
# if the backend runs in Singapore, create the cluster in ap-southeast-1.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pnsm?retryWrites=true&w=majority

# --- JWT ------------------------------------------------------------------
# HS256 (default) uses the two secrets below. RS256 (blueprint's production
# preference) uses the PEM keypair instead and ignores the secrets.
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# For RS256 only. Single-line PEM with \n escapes.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

BCRYPT_SALT_ROUNDS=12
BCRYPT_PIN_SALT_ROUNDS=10

# --- CORS -----------------------------------------------------------------
# Admin dashboard origins (browser -> REST + Socket.IO).
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
# Capacitor WebView origins. Required now that the mobile client is a
# Vite/React build in a WebView rather than a native Flutter/RN HTTP client.
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,ionic://localhost,http://localhost:5173

# --- Object storage (check-in selfies) ------------------------------------
# 'r2' (proposal) or 's3' (blueprint). Same code path, different endpoint.
STORAGE_PROVIDER=r2
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=pnsm-checkin-selfies
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
STORAGE_CHECKIN_PREFIX=checkins/
MAX_SELFIE_BYTES=524288

# --- Face verification ----------------------------------------------------
# 'mock' until Person 4's DeepFace/Rekognition service exists.
FACE_SERVICE_PROVIDER=mock
DEFAULT_FACE_MATCH_THRESHOLD=85

# --- Person 4's AI service (PIN + face verification, upload presigning) ---
# See DECISIONS.md N1/N2. Local dev: run Person4_AIBiometricService's own
# docker-compose alongside this one (ROADMAP.md Phase 5).
PNSM_AI_URL=http://localhost:8000
PNSM_HMAC_SECRET=
