# Copy to .env.local for local dev (Vite loads .env.local automatically and
# it's already gitignored — never commit real values here, though none of
# these are secrets; the mobile client never holds anything better than a
# short-lived access token in memory).

# Person 3's backend, mobile route family (DECISIONS.md N3 in PNSM_Khan_Edit).
# Default assumes the backend's own npm run dev on its default port.
VITE_API_BASE_URL=http://localhost:5000

# Set to "false" once you want every screen hitting the real backend +
# AI service instead of the built-in deterministic mock (ROADMAP.md Phase 3).
VITE_MOCK_BACKEND=false
