# pnsm-ai-svc configuration.
#
#   cp .env.example .env
#   python scripts/gen_keys.py >> .env      # fills in the four secrets
#
# Never commit .env. Both PNSM_ and bare names are accepted, so whatever a
# deployment platform's UI encourages will work.
#
# This file is the LOCAL profile. In AWS the same values arrive from the ECS
# task definition (deploy/ecs-task-definition.json) -- non-secrets as plain
# environment entries, secrets resolved from Secrets Manager -- and the two
# differences that matter are called out under each section.

# ---------------------------------------------------------------- runtime
PNSM_APP_ENV=local                  # local | staging | production | test
PNSM_LOG_LEVEL=INFO
PNSM_SERVICE_VERSION=1.0.0

# ------------------------------------------------------------ encryption
# Where data encryption keys come from.
#
#   static  a key map in this file. Local development and tests only.
#   kms     AWS KMS envelope encryption: a fresh data key per enrolment,
#           wrapped by a customer master key that never leaves KMS.
#
# The master plan requires KMS in any deployment: "the biometric arrays remain
# mathematically indecipherable without the distinct encryption keys held
# securely within the AWS Key Management Service." The service warns loudly at
# startup if it finds static keys with PNSM_APP_ENV set to anything deployed.
PNSM_KEY_PROVIDER=static
PNSM_KMS_KEY_ID=                    # arn:aws:kms:... or alias/pnsm-biometrics
PNSM_KMS_DEK_CACHE_TTL_S=300        # 0 costs a KMS round trip per check-in

# ------------------------------------------------------------- secrets ---
# Generate with scripts/gen_keys.py. Each is 32 bytes, base64.
#
# BACK UP PNSM_FLE_KEYS SOMEWHERE OUTSIDE THE DEPLOYMENT PLATFORM.
# Lose it and every embedding sealed under the static provider is permanently
# unreadable: those employees have to re-enrol. Five minutes of prevention.
#
# Under PNSM_KEY_PROVIDER=kms these keys are no longer used to seal anything
# new. Keep them until `scripts/rotate_keys.py --to kms` reports zero envelopes
# with kp=static, because they are what opens the old ones.
PNSM_FLE_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}
PNSM_FLE_ACTIVE_KEY=k1
PNSM_PIN_PEPPER=REPLACE_WITH_BASE64_32_BYTES
PNSM_HMAC_SECRET=REPLACE_WITH_BASE64_32_BYTES   # share with Person 3 only
PNSM_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING

# --------------------------------------------------------- service auth
PNSM_AUTH_REQUIRED=true             # never false outside local development
PNSM_HMAC_MAX_SKEW_S=300

# ------------------------------------------------------------------ aws
# One region for every AWS service this container talks to. Keep it equal to
# the ECS cluster's region and the MongoDB Atlas region: a cross-region hop
# costs 150-250 ms against a three-second check-in budget.
PNSM_AWS_REGION=ap-southeast-1

# ------------------------------------------------------------- storage
# MinIO locally, real S3 in AWS. Leaving PNSM_S3_ENDPOINT empty means "real
# AWS S3"; the access keys are left empty there too, because on ECS the task
# role supplies credentials and a long-lived key pair in the environment is
# exactly what the task role replaces.
PNSM_S3_ENDPOINT=http://localhost:9000
PNSM_S3_ACCESS_KEY_ID=pnsmlocal
PNSM_S3_SECRET_ACCESS_KEY=pnsmlocal-secret
PNSM_S3_BUCKET=pnsm-selfies
PNSM_S3_SSE_KMS_KEY_ID=             # SSE-KMS at rest; empty falls back to SSE-S3
PNSM_CLOUDFRONT_DOMAIN=             # deliberately empty: selfies are NOT behind
                                    # the CDN. See docs/DECISIONS.md D-14.
PNSM_PRESIGN_PUT_TTL_S=300
PNSM_PRESIGN_GET_TTL_S=120
PNSM_MAX_UPLOAD_BYTES=204800        # 200 KB, matches the mobile compression target

# --------------------------------------------------------------- model
PNSM_MODEL_DIR=models
PNSM_REC_MODEL_FILE=w600k_mbf.onnx
PNSM_DET_MODEL_FILE=face_detection_yunet_2023mar.onnx
PNSM_MODEL_VERSION=arcface_w600k_mbf_v1
PNSM_ALLOW_STUB_MODELS=false        # true ONLY for tests; results become meaningless
PNSM_WARMUP_ON_START=true

# --------------------------------------------------------- calibration
# The service refuses to start without this file: an unknown decision
# threshold is exactly what this module exists to prevent.
PNSM_CALIBRATION_PATH=calibration/calibration.json
PNSM_APPROVE_THRESHOLD=85.0         # the master plan's number, on the calibrated scale
PNSM_FLAG_THRESHOLD=60.0

# How a score below the threshold is handled.
#
#   two    the master plan: approve at or above 85, otherwise reject and raise
#          a WebSocket alert to the HR dashboard for manual auditing.
#   three  FR-07's wording: an intermediate band is flagged for review rather
#          than rejected outright.
#
# Both approve at exactly the same score. This is a policy choice, not a
# modelling one, which is why it is a setting. See docs/CALIBRATION.md.
PNSM_DECISION_BANDS=two

# ------------------------------------------------------- quality gate
# The floors a frame must clear before it reaches the model. Published to
# Person 1 and Person 2 in docs/INTEGRATION.md §4.1 so the capture UI can warn
# before an upload rather than after a rejection -- if you change one here, tell
# them, because their hints will be wrong.
#
# Enrolment holds the higher bar: a poor reference photo degrades every future
# check-in for that employee, and it is taken once, under supervision.
#
# The suite lowers the blur floors, because the synthetic test frames are
# sharper than any real photograph.
PNSM_MIN_DET_SCORE=0.80
PNSM_MIN_BLUR_VAR=80.0
PNSM_MIN_FACE_AREA_RATIO=0.015
PNSM_MIN_BRIGHTNESS=45.0
PNSM_MAX_BRIGHTNESS=215.0
PNSM_ENROL_MIN_DET_SCORE=0.90
PNSM_ENROL_MIN_BLUR_VAR=120.0
PNSM_ENROL_MIN_FACE_AREA_RATIO=0.04

# ---------------------------------------------------------- security
PNSM_MAX_CLOCK_SKEW_S=120           # how stale a capture may be
PNSM_NONCE_TTL_S=600                # request-id replay window
PNSM_IMAGE_REPLAY_WINDOW=30         # selfies remembered per employee
PNSM_VERIFY_RATE_LIMIT_PER_MIN=12

# ------------------------------------------------ response headers (A02)
# The API returns only JSON, so it can afford the strictest CSP there is.
# HSTS is emitted only over HTTPS, so this is harmless on a local HTTP run.
PNSM_SECURITY_HEADERS=true
PNSM_CSP_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
PNSM_HSTS_MAX_AGE_S=31536000
