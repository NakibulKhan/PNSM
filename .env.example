# Root compose secrets, shared across services (ROADMAP.md Phase 5).
#
#   cp .env.example .env
#
# .env is git-ignored. The values below are REAL, freshly-generated dev-only
# secrets (via Person4_AIBiometricService/scripts/gen_keys.py) — this is a
# local course project with no real deployment behind it, so they are
# committed here for a turnkey `docker compose up`, unlike every quadrant's
# own .env.example, which leaves secrets blank on purpose (see each one's own
# file for why: those are the templates for a real deployment). If this
# project is ever deployed anywhere reachable, regenerate all of these first.

# --- Shared between backend and ai-service (DECISIONS.md N1) ---------------
# Must be byte-identical in both containers — a mismatch fails every
# backend -> AI-service call with 401 and no further diagnostic.
PNSM_HMAC_SECRET=p9NhE2FvNCWUkTyJWgVUyder0F/xIoV2HUupqY/wy1o=

# --- ai-service only (Person4_AIBiometricService/.env.example) -------------
PNSM_FLE_KEYS={"k1":"Mn8ZtuJzkHRi5y2hQTRo/qt32mjZ0l7aLrxSK5bln9s="}
PNSM_FLE_ACTIVE_KEY=k1
PNSM_PIN_PEPPER=c5x+e8e/pCj/iVmp2O4vixtoyRlUyeCJ3Mhvd5wazhw=
PNSM_ADMIN_TOKEN=3tuaEg9ZeD2RSFSyJFvzI52a6npKtG6u

# --- backend only (Person3_BackendAPI/.env.example) -------------------------
# HS256 only needs a non-empty string; these are dev-only, unlike the four
# secrets above they are not full 32-byte keys because nothing requires it.
JWT_ACCESS_SECRET=pnsm-local-dev-access-secret-change-if-ever-deployed
JWT_REFRESH_SECRET=pnsm-local-dev-refresh-secret-change-if-ever-deployed

# Item 9 (Flawless/Ultra blueprint) — AES-256-GCM field encryption for
# AttendanceLog/SpoofAlert gps_location, the local QE-replacement key. Same
# JSON-map-of-base64-keys shape as PNSM_FLE_KEYS above, distinct namespace so
# rotating one never touches the other.
PNSM_GEO_FLE_KEYS={"k1":"lnXkHOcjHohISZplJ9ZOi0YCc414MKKIpQ4+LHgV2HE="}
PNSM_GEO_FLE_ACTIVE_KEY=k1

# --- MongoDB Atlas (DECISIONS.md N40) ---------------------------------------
# UNLIKE every other value in this file, this is a credential for a real,
# internet-reachable external service, not a local-only secret — left BLANK
# here on purpose (the one deliberate exception to this file's own "real,
# committed dev secrets" convention explained at the top). Get the real
# connection string from Atlas's own "Connect" UI (standard/non-SRV format),
# substitute <db_username>/<db_password>, and add the database name (`pnsm`)
# to the path — Atlas's own template omits it. Double-check the `replicaSet`
# parameter's exact case against `rs.status().set` (via a
# `directConnection=true` connection) rather than trusting the UI's display
# capitalization — see SETUP.md for why that specific gotcha is worth this
# warning.
MONGODB_URI=

# --- MinIO (both mongo and minio read from docker-compose.yml directly;
# these two are the only MinIO values with a default worth overriding) ------
MINIO_ROOT_USER=pnsmlocal
MINIO_ROOT_PASSWORD=pnsmlocal-secret
